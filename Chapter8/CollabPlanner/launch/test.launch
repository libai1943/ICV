<?xml version="1.0"?>
<launch>
    <!-- <rosparam file="$(find collab_planner)/config/car_positions.yaml" command="load"/> -->
    <node pkg="collab_planner" type="collab_planner_node" name="collab_planner_node" output="screen">
        <rosparam command="load" file="$(find collab_planner)/config/collab_traj_planner.yaml" ns="collab_planner"/>
        <rosparam command="load" file="$(find collab_planner)/config/car_positions.yaml" ns="collab_planner"/>
    </node>

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find collab_planner)/config/exp.rviz"/>
</launch>